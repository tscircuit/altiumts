{
  "name": "altiumts",
  "version": "0.0.7",
  "description": "TypeScript-first parser and serializer for Altium document formats",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tscircuit/altiumts"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsup-node lib/index.ts --format esm --dts",
    "download-references": "bun run scripts/download-references.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "inventory-references": "bun run scripts/inventory-references.ts",
    "lint": "biome check .",
    "test": "bun test",
    "test:update-svg": "BUN_UPDATE_SNAPSHOTS=1 bun test tests/svg",
    "typecheck": "bunx tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/bun": "^1.3.14",
    "bun-match-svg": "^0.0.15",
    "sharp": "^0.34.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "sharp": "^0.34.5"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
